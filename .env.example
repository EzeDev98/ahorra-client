# Base URL of ahorra-server, including its base path (/api/v1). No trailing slash.
VITE_API_BASE_URL=http://localhost:2050/api/v1
# Areas answered by a local stand-in because the server has no endpoint yet. Remove a name when its endpoint exists.
VITE_STAND_INS=
# Development only: true lets a browser tab use the app without installing it. Ignored in production builds.
VITE_SKIP_INSTALL_GUARD=false
# Public key for web push (VAPID). Leave empty while the push stand-in is on.
VITE_VAPID_PUBLIC_KEY=BN5bCP79DEb_tcTaZWZxlvjRZmSF2wjiggn2G2lpXJhYDk2A-it5GMbv-2Vd4L734OJCFlVFPC9r1VSkbRfKHg4
